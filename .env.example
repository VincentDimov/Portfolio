# Server-only SMTP configuration. Do not add a VITE_ prefix.
# Copy to .env.local for local development; keep real values out of Git.
SMTP_HOST=send.one.com
# 465 uses implicit TLS. Other SMTP ports require a successful STARTTLS upgrade.
SMTP_PORT=465
SMTP_USER=vincent@dspab.se
SMTP_PASS=
# A single verified sender address authorised by your SMTP provider.
SMTP_FROM=vincent@dspab.se

# Optional exact HTTPS site origin for an authorised preview/custom domain.
# Production and localhost ports 5173/4173 are already allowed by the server.
CONTACT_SITE_URL=
